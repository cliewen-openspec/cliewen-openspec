  "scripts": {
    ".tmp/run-upgrade-minimum.mjs": "import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import assert from 'node:assert/strict';import {spawnSync} from 'node:child_process';import {createHash} from 'node:crypto';\nconst source=process.cwd(),root=fs.mkdtempSync(path.join(os.tmpdir(),'cliewen-upgrade-minimum-')),npm='C:/Program Files/nodejs/node_modules/npm/bin/npm-cli.js',node20=path.join(source,'.tmp/minimum-runtime/node_modules/node/bin/node.exe'),records=[];\nfunction run(exe,args,cwd=root){const r=spawnSync(exe,args,{cwd,encoding:'utf8',timeout:90000,env:{...process.env,OPENSPEC_TELEMETRY:'0',CI:'1'}});records.push({exe,args,cwd,status:r.status,stdout:r.stdout,stderr:r.stderr,error:String(r.error??'')});assert.equal(r.status,0,r.stdout+r.stderr);return r.stdout.trim();}\ntry {\n const pack=JSON.parse(run(process.execPath,[npm,'pack','--ignore-scripts','--json','--pack-destination',root],source))[0],tar=path.join(root,pack.filename);\n fs.writeFileSync(path.join(root,'package.json'),'{\"private\":true}');run(process.execPath,[npm,'install','--ignore-scripts','--no-audit','--no-fund',tar,'@fission-ai/openspec@1.15.0']);\n assert.equal(run(node20,['--version']),'v20.19.0');\n const osCli=path.join(root,'node_modules/@fission-ai/openspec/bin/openspec.js'),cli=path.join(root,'node_modules/cliewen-openspec/dist/cli.js');\n run(node20,[osCli,'init','--tools','none','--no-animation']);\n const preview=JSON.parse(run(node20,[cli,'init','--dry-run','--json']));assert.equal(preview.compatibility.node.version,'20.19.0');assert.equal(preview.compatibility.openspec.version,'1.15.0');\n run(node20,[cli,'init','--json']);fs.writeFileSync(path.join(root,'.cliewen-openspec/config.yaml'),'features: {evidence: false}\\n');\n for(const args of [['update','--dry-run','--json'],['update','--json'],['check','--json']])run(node20,[cli,...args]);\n for(const schema of ['cliewen-delivery','cliewen-discovery','cliewen-all'])run(node20,[osCli,'schema','validate',schema]);\n fs.writeFileSync('.tmp/upgrade-minimum-result.json',JSON.stringify({passed:true,root,packageSha256:createHash('sha256').update(fs.readFileSync(tar)).digest('hex'),records},null,2));\n} catch(e){fs.writeFileSync('.tmp/upgrade-minimum-result.json',JSON.stringify({passed:false,root,error:String(e.stack??e),records},null,2));throw e;}\n",
    ".tmp/check-upgrade-faults.mjs": "import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';\nconst source=process.cwd(),root=fs.mkdtempSync(path.join(os.tmpdir(),'cliewen-upgrade-faults-')),results=[];\nfor(const [name,file,needle,replacement]of [\n ['accept-incompatible-openspec','dist/compatibility.js','if (!meetsMinimum(output, requirements.openspec))','if (false)'],\n ['overwrite-local-resource-edit','dist/core.js','if (hash(current) !== oldHash && normalize(current) !== normalize(content))','if (false)']\n]){\n const project=path.join(root,name);fs.mkdirSync(project);\n for(const folder of ['dist','schemas','test'])fs.cpSync(path.join(source,folder),path.join(project,folder),{recursive:true});\n fs.copyFileSync(path.join(source,'package.json'),path.join(project,'package.json'));\n fs.symlinkSync(path.join(source,'node_modules'),path.join(project,'node_modules'),process.platform==='win32'?'junction':'dir');\n const target=path.join(project,file),text=fs.readFileSync(target,'utf8');assert.ok(text.includes(needle),name);fs.writeFileSync(target,text.replace(needle,replacement));\n const r=spawnSync(process.execPath,['--test','test/installation-upgrades.test.mjs'],{cwd:project,encoding:'utf8',timeout:30000,env:{...process.env,PATH:path.join(source,'node_modules/.bin')+path.delimiter+process.env.PATH}});\n fs.writeFileSync(path.join(project,'test.log'),r.stdout+r.stderr);\n assert.equal(r.status,1,r.stdout+r.stderr);assert.match(r.stdout+r.stderr,/ERR_ASSERTION|AssertionError/);assert.doesNotMatch(r.stdout+r.stderr,/ERR_MODULE_NOT_FOUND|SyntaxError/);\n results.push({name,detectedByAssertion:true,exitCode:r.status,project,output:r.stdout+r.stderr});\n}\nfs.writeFileSync('.tmp/upgrade-fault-results.json',JSON.stringify({root,results},null,2));\n",
    ".tmp/run-upgrade-linux.sh": "#!/usr/bin/env bash\nset -euo pipefail\ntrial_dir=$(mktemp -d /tmp/cliewen-upgrade-linux-XXXXXX)\nresult_dir=/mnt/c/Code/cliewen-openspec/.tmp/upgrade-linux-results\nmkdir -p \"$result_dir\"\ntrap 'cp \"$trial_dir\"/*.log \"$result_dir\"/ 2>/dev/null || true' EXIT\nprintf '%s\\n' \"$trial_dir\" > /mnt/c/Code/cliewen-openspec/.tmp/upgrade-linux-root.txt\ncd /mnt/c/Code/cliewen-openspec\ntar --exclude=.git --exclude=node_modules --exclude=.tmp --exclude=dist --exclude=site --exclude=.vitepress/cache --exclude=.vitepress/dist -cf - . | tar -xf - -C \"$trial_dir\"\ncd \"$trial_dir\"\nnpm ci --no-audit --no-fund > npm-ci.log 2>&1\nnpm run build > build.log 2>&1\nexport PATH=\"$trial_dir/node_modules/.bin:$PATH\"\nexport npm_execpath=/usr/lib/node_modules/npm/bin/npm-cli.js\nnode --test test/installation-upgrades.test.mjs test/update.test.mjs test/uninstall.test.mjs test/release-version.test.mjs test/upgrade-consumer.test.mjs > tests.log 2>&1\n"
